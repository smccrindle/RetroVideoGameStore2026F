@{
    ViewData["Title"] = "Browse";
}
@if (ViewBag.CategoryName == null){
    // No category name provided, display a message
    <h1>No category selected</h1>
    <a asp-controller="Categories" asp-action="Index">Back to categories</a>
}
else
{
    <h1>You are browsing @ViewBag.CategoryName</h1>
}
